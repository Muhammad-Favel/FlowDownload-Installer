{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDownload Installer",
  "version": "0.1.0",
  "identifier": "com.example.flowdownload.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlowDownload Installer",
        "width": 740,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
